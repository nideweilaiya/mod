{
  "id": "gather_logs",
  "name": "采集木材",
  "need": "wood",
  "block_keywords": ["_log", "_stem", "wood", "_hyphae"],
  "action_sequence": [
    {
      "action": "EquipItem",
      "params": { "keyword": "axe" }
    },
    {
      "action": "NavigateToInteract",
      "params": { "target": "$found_block.pos" }
    },
    {
      "action": "repeat",
      "condition": { "block_matches": "_log" },
      "body": [
        {
          "action": "BreakBlock",
          "params": { "target": "$current_target" }
        },
        {
          "action": "PickupItem",
          "params": { "item_filter": "log" }
        },
        {
          "action": "MoveUpTarget",
          "params": {}
        }
      ]
    }
  ]
}
